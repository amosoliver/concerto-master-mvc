<%= form_with(model: m_ensaio, local: true, class: "panel-card form-card", data: { controller: "select" }) do |form| %>
  <%= hidden_field_tag :step, current_step %>

  <%= render "shared/form_errors", record: m_ensaio %>

  <%= render "shared/steps_nav", steps: MEnsaiosController::STEPS, current_step: current_step %>

  <% if current_step == "dados" %>
    <div class="panel-card panel-card--embedded">
      <div class="panel-card__header">
        <div>
          <p class="eyebrow">Etapa 1</p>
          <h3>Dados principais do ensaio</h3>
        </div>
      </div>

      <div class="form-grid">
        <div class="field-group">
          <%= form.label :descricao %>
          <%= form.text_field :descricao, class: "form-control" %>
        </div>
        <div class="field-group">
          <%= form.label :data_inicio %>
          <%= form.datetime_field :data_inicio, class: "form-control" %>
        </div>
        <div class="field-group">
          <%= form.label :data_fim %>
          <%= form.datetime_field :data_fim, class: "form-control" %>
        </div>
        <div class="field-group">
          <%= form.label :g_predio_id %>
          <%= form.collection_select :g_predio_id, @g_predios, :id, :to_s, { include_blank: true }, class: "form-control" %>
        </div>
        <div class="field-group">
          <label>Entidade</label>
          <div class="form-control form-control--static"><%= current_context_entidade || "Sem entidade vinculada" %></div>
        </div>
      </div>
    </div>

  <% elsif current_step == "grupos_eventos" %>
    <div class="panel-card panel-card--embedded">
      <div class="panel-card__header">
        <div>
          <p class="eyebrow">Etapa 2</p>
          <h3>Grupos e eventos deste ensaio</h3>
        </div>
      </div>

      <section class="show-section show-section--embedded">
        <div class="panel-card__header">
          <div>
            <p class="eyebrow">Grupos</p>
            <h3>Grupos da entidade neste ensaio</h3>
          </div>
        </div>

        <% if @grupos_disponiveis.any? %>
          <%= hidden_field_tag "m_ensaio[m_grupo_ids][]", "" %>
          <div class="related-grid">
            <% @grupos_disponiveis.each do |grupo| %>
              <article class="related-card related-card--selectable">
                <label class="selection-item">
                  <%= check_box_tag "m_ensaio[m_grupo_ids][]", grupo.id, @selected_group_ids.include?(grupo.id) %>
                  <span>
                    <strong><%= grupo.descricao %></strong><br>
                    <small><%= [grupo.m_tipo_grupo, pluralize(grupo.g_pessoas.size, "pessoa")].compact.join(" • ") %></small>
                  </span>
                </label>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="empty-card">Nenhum grupo disponível para esta entidade.</div>
        <% end %>
      </section>

      <section class="show-section show-section--embedded">
        <div class="panel-card__header">
          <div>
            <p class="eyebrow">Eventos</p>
            <h3>Eventos que alimentam o ensaio</h3>
          </div>
        </div>

        <% if @eventos_disponiveis.any? %>
          <%= hidden_field_tag "m_ensaio[m_evento_ids][]", "" %>
          <div class="related-grid">
            <% @eventos_disponiveis.each do |evento| %>
              <article class="related-card related-card--selectable">
                <label class="selection-item">
                  <%= check_box_tag "m_ensaio[m_evento_ids][]", evento.id, @selected_event_ids.include?(evento.id) %>
                  <span>
                    <strong><%= evento.descricao %></strong><br>
                    <small><%= [format_datetime(evento.data_inicio), evento.g_predio, pluralize(evento.m_eventos_musicas.count, "música")].compact.join(" • ") %></small>
                  </span>
                </label>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="empty-card">Nenhum evento disponível para montar ensaio.</div>
        <% end %>
      </section>
    </div>

  <% elsif current_step == "repertorio" %>
    <div class="panel-card panel-card--embedded">
      <div class="panel-card__header">
        <div>
          <p class="eyebrow">Etapa 3</p>
          <h3>Músicas que serão ensaiadas</h3>
        </div>
      </div>

      <% eventos_selecionados = @eventos_disponiveis.select { |evento| @selected_event_ids.include?(evento.id) } %>
      <% if eventos_selecionados.empty? %>
        <div class="empty-card">Volte para a etapa anterior e selecione ao menos um evento para montar o repertório.</div>
      <% else %>
        <% repertorio_index = 0 %>
        <div class="ensaio-repertorio">
          <% eventos_selecionados.each do |evento| %>
            <% musicas_evento = evento.m_eventos_musicas.sort_by { |evento_musica| evento_musica.m_musica&.descricao.to_s } %>
            <section class="ensaio-repertorio__group">
              <div class="ensaio-repertorio__group-header">
                <div>
                  <span class="related-card__label">Evento fonte</span>
                  <strong><%= evento.descricao %></strong>
                </div>
                <span class="related-card__meta"><%= [format_datetime(evento.data_inicio), evento.g_predio].compact.join(" • ") %></span>
              </div>

              <% if musicas_evento.any? %>
                <div class="wizard-repertorio">
                  <% musicas_evento.each do |evento_musica| %>
                    <% musica = evento_musica.m_musica %>
                    <% arranjo = evento_musica.m_arranjo %>
                    <% selected_entry = @selected_repertorio[evento_musica.id] || {} %>
                    <% checked = selected_entry.present? %>
                    <article class="wizard-repertorio__item">
                      <div class="wizard-repertorio__header">
                        <label class="selection-item">
                          <%= check_box_tag "m_ensaio[repertorio][#{repertorio_index}][selecionada]", "1", checked %>
                          <span><strong><%= musica&.descricao || "Música sem descrição" %></strong></span>
                        </label>
                        <%= hidden_field_tag "m_ensaio[repertorio][#{repertorio_index}][m_evento_musica_id]", evento_musica.id %>
                      </div>

                      <div class="wizard-repertorio__meta">
                        <span><%= evento.to_s %></span>
                        <span><%= musica&.m_artista || "Sem artista" %></span>
                        <span><%= arranjo.presence || "Sem arranjo definido" %></span>
                      </div>

                      <div class="field-group">
                        <label>Observação deste ensaio</label>
                        <%= text_field_tag "m_ensaio[repertorio][#{repertorio_index}][observacao]",
                                           selected_entry[:observacao],
                                           class: "form-control",
                                           placeholder: "Ex.: revisar entrada, corrigir dinâmica, reforçar final" %>
                      </div>
                    </article>
                    <% repertorio_index += 1 %>
                  <% end %>
                </div>
              <% else %>
                <div class="empty-card">Este evento ainda não possui músicas vinculadas.</div>
              <% end %>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="panel-card panel-card--embedded">
      <div class="panel-card__header">
        <div>
          <p class="eyebrow">Etapa 4</p>
          <h3>Revisão antes de salvar</h3>
        </div>
      </div>

      <div class="detail-grid">
        <div class="detail-tile">
          <span class="detail-label">Ensaio</span>
          <span class="detail-value"><%= m_ensaio.descricao.presence || "Preencha a descrição no passo 1" %></span>
        </div>
        <div class="detail-tile">
          <span class="detail-label">Prédio</span>
          <span class="detail-value"><%= m_ensaio.g_predio || "Selecione um prédio" %></span>
        </div>
        <div class="detail-tile">
          <span class="detail-label">Período</span>
          <span class="detail-value"><%= format_datetime_range(m_ensaio.data_inicio, m_ensaio.data_fim) %></span>
        </div>
        <div class="detail-tile">
          <span class="detail-label">Grupos</span>
          <span class="detail-value"><%= pluralize(@selected_group_ids.size, "grupo") %> selecionado(s)</span>
        </div>
        <div class="detail-tile">
          <span class="detail-label">Eventos</span>
          <span class="detail-value"><%= pluralize(@selected_event_ids.size, "evento") %> selecionado(s)</span>
        </div>
        <div class="detail-tile">
          <span class="detail-label">Repertório</span>
          <span class="detail-value"><%= pluralize(@selected_repertorio.size, "música") %> selecionada(s)</span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="form-actions">
    <% unless first_step? %>
      <%= button_tag "Voltar", name: :navigation, value: "previous", class: "secondary-button" %>
    <% end %>
    <%= form.submit(last_step? ? (m_ensaio.persisted? ? "Atualizar ensaio" : "Criar ensaio") : "Próximo", class: "primary-button") %>
    <%= link_to "Cancelar", m_ensaio.persisted? ? m_ensaio_path(m_ensaio) : m_ensaios_path, class: "secondary-button" %>
  </div>
<% end %>
